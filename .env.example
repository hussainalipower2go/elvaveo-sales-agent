# Resend Email Configuration (SERVER-ONLY)
# Use Resend exclusively. Never use Gmail or personal email accounts.
RESEND_API_KEY=re_your_resend_api_key_here

# Resend Webhook Signing Secret (SERVER-ONLY)
# Found in Resend Dashboard -> Webhooks -> Signing Secret (starts with whsec_...)
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Unsubscribe Token Encryption / Signing Secret (SERVER-ONLY)
# 32+ character random string used to sign HMAC-SHA256 unsubscribe tokens
UNSUBSCRIBE_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# Application Public URL (Used for generating unsubscribe links and webhook callbacks)
# Local development: http://localhost:3000
# Production: https://sales.elvaveo.com
APP_URL=http://localhost:3000

# Sending Mode: 'test' or 'live' (Defaults to 'test' for safety)
# In 'test' mode, emails ONLY go to TEST_RECIPIENTS and have [TEST] in the subject.
# To enable live outreach, you must explicitly set SEND_MODE=live.
SEND_MODE=test

# Authorized Test Recipient(s) (Comma-separated list of addresses you own and control)
# Example: testing@elvaveo.com,dev@yourdomain.com
TEST_RECIPIENTS=operator-test@elvaveo.com

# Business Physical Mailing Address (Required for CAN-SPAM / legal compliance in live mode)
# Must be your actual registered physical business address (Street, Suite, City, State/Province, Postal Code, Country)
# Live sending is strictly blocked if this is empty.
BUSINESS_ADDRESS=
BUSINESS_LEGAL_NAME=ELVAVEO

# Conservative Sending Limits (Durable database-backed safeguards)
# Maximum emails allowed per workspace in a 24-hour rolling window
DAILY_SEND_LIMIT_WORKSPACE=50

# Maximum emails allowed per workspace in a 1-hour rolling window
HOURLY_SEND_LIMIT_WORKSPACE=10

# Minimum days to wait before sending another outreach email to the same recipient
MIN_INTERVAL_DAYS_RECIPIENT=7
